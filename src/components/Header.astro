---
---

<header class="app-header">
  <div class="brand-section">
    <div class="brand-logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>
    <div class="brand-title-wrap">
      <h1 class="brand-title">
        MicroConvert
        <span class="version-badge">Client-Side v1.0</span>
      </h1>
      <p class="brand-tagline">Private, In-Browser Markdown to PDF Utility</p>
    </div>
  </div>

  <div class="header-actions">
    <!-- Tool Selector for Extensible Architecture -->
    <div class="converter-selector-wrap" title="Switch active file conversion tool">
      <span class="converter-selector-label">Tool:</span>
      <select id="converter-select" class="converter-select" aria-label="Select Converter Engine">
        <option value="md-to-pdf">Markdown to PDF</option>
      </select>
    </div>

    <!-- Privacy Indicator Badge -->
    <div class="privacy-badge" title="No data leaves this browser tab">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>100% In-Browser</span>
    </div>
  </div>
</header>
