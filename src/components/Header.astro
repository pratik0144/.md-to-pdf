---
/**
 * ============================================================================
 * HEADER COMPONENT (`Header.astro`)
 * ============================================================================
 * 
 * ROLE OF THIS COMPONENT:
 * Renders the top navigation bar containing:
 * 1. Brand Logo & Product Identity: Shows "MicroConvert" and version badge.
 * 2. Extensible Tool Selector (`#converter-select`):
 *    A dropdown menu that is dynamically populated at runtime by `app.ts` with
 *    all converters registered in the `ConverterRegistry`.
 * 3. Privacy Assurance Badge:
 *    A green lock badge assuring the user that document conversion runs 100%
 *    inside their local browser memory without network transmission.
 */
---

<header class="app-header">
  <!-- Brand Logo and Tagline -->
  <div class="brand-section">
    <div class="brand-logo" aria-hidden="true">
      <!-- Document File SVG Icon -->
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>
    <div class="brand-title-wrap">
      <h1 class="brand-title">
        MicroConvert
        <span class="version-badge">Client-Side v1.0</span>
      </h1>
      <p class="brand-tagline">Private, In-Browser Markdown to PDF Utility</p>
    </div>
  </div>

  <!-- Header Right Actions -->
  <div class="header-actions">
    <!--
      EXTENSIBLE TOOL SELECTOR:
      When `app.ts` initializes, it queries `converterRegistry.getAll()` and generates
      an `<option>` element for each registered converter (e.g. Markdown-to-PDF, Plain Text-to-PDF).
      Selecting an option switches the active converter engine on the fly!
    -->
    <div class="converter-selector-wrap" title="Switch active file conversion tool">
      <span class="converter-selector-label">Tool:</span>
      <select id="converter-select" class="converter-select" aria-label="Select Converter Engine">
        <option value="md-to-pdf">Markdown to PDF</option>
      </select>
    </div>

    <!-- Privacy Indicator Badge -->
    <div class="privacy-badge" title="No data leaves this browser tab">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>100% In-Browser</span>
    </div>
  </div>
</header>
