---
---

<div class="action-toolbar" aria-label="Editor controls and PDF options">
  <!-- Active File Information -->
  <div class="file-status-info">
    <div class="current-file-tag" title="Active Document Name">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span id="current-file-name">document.md</span>
    </div>

    <div class="stat-pills">
      <span id="stat-word-count" class="stat-pill">0 words</span>
      <span id="stat-char-count" class="stat-pill">0 chars</span>
      <span id="stat-line-count" class="stat-pill">0 lines</span>
    </div>
  </div>

  <!-- PDF Output Configuration Settings -->
  <div class="pdf-settings-bar">
    <div class="pdf-setting-group">
      <label for="paper-format-select">Format:</label>
      <select id="paper-format-select" class="pdf-setting-select" title="Select Paper Size">
        <option value="a4" selected>A4</option>
        <option value="letter">Letter</option>
        <option value="legal">Legal</option>
      </select>
    </div>

    <div class="pdf-setting-group">
      <label for="orientation-select">Orientation:</label>
      <select id="orientation-select" class="pdf-setting-select" title="Select Document Orientation">
        <option value="portrait" selected>Portrait</option>
        <option value="landscape">Landscape</option>
      </select>
    </div>

    <div class="pdf-setting-group">
      <label for="margin-select">Margins:</label>
      <select id="margin-select" class="pdf-setting-select" title="Select Page Margins">
        <option value="normal" selected>Normal (14mm)</option>
        <option value="compact">Compact (10mm)</option>
        <option value="spacious">Spacious (18mm)</option>
      </select>
    </div>
  </div>

  <!-- Actions & Prominent Download Button -->
  <div class="toolbar-actions">
    <button id="load-sample-btn" class="btn btn-secondary" title="Load sample CommonMark + GFM document">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
      </svg>
      <span>Load Sample</span>
    </button>

    <button id="clear-btn" class="btn btn-danger-subtle" title="Clear current document">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
      <span>Clear</span>
    </button>

    <button id="download-btn" class="btn btn-primary" disabled title="Generate and download PDF">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>Download PDF</span>
    </button>
  </div>
</div>
